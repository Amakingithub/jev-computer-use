# Jev decision-layer / computer-use env. NEVER commit real keys.
# Copy to .env and fill. Keys also live (canonically) in: C:\Users\USER\.agents\knowledge\api-providers.md

# --- Official TypeSafe API (priority 1) ---
TYPESAFE_API_KEY=

# --- Cloudflare Workers AI (priority 2, free typesafe/jev tier) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=cfut_...

# --- OpenRouter (priority 3, prepaid credits; typesafe/jev-1.13) ---
# Set or comma-separate multiple keys; first usable wins.
OPENROUTER_API_KEY=

# --- Optional: backing LLM/VLM tiers for computer-use escalation ---
GROQ_API_KEY=
GEMINI_API_KEY=